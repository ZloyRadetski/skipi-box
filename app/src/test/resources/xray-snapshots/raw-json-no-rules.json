    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": [
          "domain:raw.example"
        ],
        "skipFallback": true,
        "tag": "dns-direct"
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "domains": [
          "domain:raw.example"
        ],
        "skipFallback": true,
        "tag": "dns-direct"
      },
      "https://8.8.8.8/dns-query"
