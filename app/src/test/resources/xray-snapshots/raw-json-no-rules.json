  "inbounds": [],
  "log": {
    "access": "none",
    "dnsLog": false,
    "error": "/tmp/error.log",
    "loglevel": "error"
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "raw.example",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "id": "4219d973-8792-462f-8747-df766f70f137"
              }
            ]
          }
        ]
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "tag": "local"
    },
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      },
      "streamSettings": {
        "sockopt": {
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 60,
          "tcpUserTimeout": 10000
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "dns",
      "settings": {
        "rewriteAddress": "8.8.8.8",
        "rewriteNetwork": "tcp",
        "rewritePort": 53,
        "rules": [
          {
            "action": "hijack",
            "qType": "1,28"
          },
          {
            "action": "direct"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "proxy"
        }
      },
      "tag": "dns-out"
    }
  ],
  "policy": {
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "vpn-tun-in"
        ],
        "network": "tcp,udp",
        "outboundTag": "dns-out",
        "port": "53"
      },
      {
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "domain": [
          "direct.example"
        ],
        "outboundTag": "local"
      }
    ]
  },
  "stats": {}
