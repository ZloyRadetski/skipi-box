// Draft only: move to shared/app/src/commonTest after the P03 API and Android baseline gate.
package app.skipi.app.config

import features.config.TrafficConfigCustomResourceFile
import features.config.TrafficConfigResourceSettings
import features.config.TrafficConfigState
import features.config.withSkipiSettingsInRawConfig
import features.config.withSkipiSettingsReadFromRawConfig
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFalse
import kotlin.test.assertTrue

class TrafficConfigProfileRefreshOperationsTestDraft {
    @Test
    fun manualRefreshTakesFetchedPolicyAndUnlockOverridesFetchedLock() {
        val current = profile(id = 17, locked = false, auto = false, interval = "48", geoAuto = false, geoInterval = "72")
        val url = "https://captured.example/profile.conf"
        val updatedAt = 321_000L

        val locked = TrafficConfigProfileRefreshOperations.apply(
            current = current,
            normalizedDocument = fetchedDocument,
            capturedUrl = url,
            timestamp = updatedAt,
            mode = TrafficConfigProfileRefreshMode.Manual(unlock = false),
        )
        assertEquals(17, locked.id)
        assertEquals("Fetched name", locked.name)
        assertEquals(url, locked.sourceUrl)
        assertEquals(updatedAt, locked.lastUpdatedAtMillis)
        assertTrue(locked.updateLocked)
        assertTrue(locked.autoUpdate)
        assertEquals("6", locked.updateInterval)
        assertEquals("profile-agent", locked.resourceSettings.userAgent)
        assertPortableSettingsMatchRaw(locked)

        val unlocked = TrafficConfigProfileRefreshOperations.apply(
            current = current,
            normalizedDocument = fetchedDocument,
            capturedUrl = url,
            timestamp = updatedAt,
            mode = TrafficConfigProfileRefreshMode.Manual(unlock = true),
        )
        assertFalse(unlocked.updateLocked)
        assertTrue(unlocked.rawConfig.contains("profile-update-locked = false"))
        assertPortableSettingsMatchRaw(unlocked)
    }

    @Test
    fun automaticRefreshPreservesCurrentScheduleButImportsFetchedResourceContent() {
        val current = profile(id = 29, locked = true, auto = false, interval = "96", geoAuto = false, geoInterval = "120")
        val url = "https://captured.example/automatic.conf"

        val updated = TrafficConfigProfileRefreshOperations.apply(
            current = current,
            normalizedDocument = fetchedDocument,
            capturedUrl = url,
            timestamp = 654_000L,
            mode = TrafficConfigProfileRefreshMode.Automatic,
        )

        assertEquals(29, updated.id)
        assertEquals("Fetched name", updated.name)
        assertEquals(url, updated.sourceUrl)
        assertEquals(654_000L, updated.lastUpdatedAtMillis)
        assertTrue(updated.updateLocked)
        assertFalse(updated.autoUpdate)
        assertEquals("96", updated.updateInterval)
        assertEquals(23, updated.resourceSettings.source)
        assertEquals("https://geo.example/ip.dat", updated.resourceSettings.customGeoIpUrl)
        assertEquals("https://geo.example/site.dat", updated.resourceSettings.customGeoSiteUrl)
        assertEquals("profile-agent", updated.resourceSettings.userAgent)
        assertEquals(listOf(TrafficConfigCustomResourceFile(6, "Extra", "https://geo.example/extra.dat")), updated.resourceSettings.customFiles)
        assertEquals(7, updated.resourceSettings.nextCustomFileId)
        assertFalse(updated.resourceSettings.autoUpdate)
        assertEquals("120", updated.resourceSettings.updateInterval)
        assertPortableSettingsMatchRaw(updated)
    }

    private fun assertPortableSettingsMatchRaw(profile: TrafficConfigState) {
        val parsed = profile.withSkipiSettingsReadFromRawConfig()
        assertEquals(profile.name, parsed.name)
        assertEquals(profile.updateLocked, parsed.updateLocked)
        assertEquals(profile.autoUpdate, parsed.autoUpdate)
        assertEquals(profile.updateInterval, parsed.updateInterval)
        assertEquals(profile.resourceSettings, parsed.resourceSettings)
    }

    private fun profile(
        id: Int,
        locked: Boolean,
        auto: Boolean,
        interval: String,
        geoAuto: Boolean,
        geoInterval: String,
    ) = TrafficConfigState(
        id = id,
        name = "Current",
        rawConfig = "[General]\nloglevel = warning\n",
        sourceUrl = "https://old.example/profile.conf",
        updateLocked = locked,
        lastUpdatedAtMillis = 10L,
        autoUpdate = auto,
        updateInterval = interval,
        resourceSettings = TrafficConfigResourceSettings(
            source = 2,
            customGeoIpUrl = "https://old.example/ip.dat",
            userAgent = "old-agent",
            autoUpdate = geoAuto,
            updateInterval = geoInterval,
        ),
    ).withSkipiSettingsInRawConfig()

    private val fetchedDocument = TrafficConfigState(
        id = 99,
        name = "Fetched name",
        rawConfig = "[General]\nloglevel = warning\n",
        updateLocked = true,
        autoUpdate = true,
        updateInterval = "6",
        resourceSettings = TrafficConfigResourceSettings(
            source = 23,
            customGeoIpUrl = "https://geo.example/ip.dat",
            customGeoSiteUrl = "https://geo.example/site.dat",
            customDirectCidrIpv4Url = "https://geo.example/direct-v4.dat",
            customFiles = listOf(TrafficConfigCustomResourceFile(6, "Extra", "https://geo.example/extra.dat")),
            nextCustomFileId = 7,
            userAgent = "profile-agent",
            autoUpdate = true,
            updateInterval = "3",
        ),
    ).withSkipiSettingsInRawConfig().rawConfig
}

