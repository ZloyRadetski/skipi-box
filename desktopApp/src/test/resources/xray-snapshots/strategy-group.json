      "one.one.one.one": [
        "1.1.1.1",
        "1.0.0.1"
      ]
    },
    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": [
          "domain:a.example",
          "domain:b.example",
          "domain:c.example"
        ],
        "skipFallback": true,
        "tag": "dns-direct"
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "domains": [
          "domain:a.example",
          "domain:b.example",
          "domain:c.example"
        ],
        "skipFallback": true,
        "tag": "dns-direct"
      },
      "https://8.8.8.8/dns-query"
    ],
    "tag": "dns-proxy"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 20480,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "ip": "127.0.0.1",
        "udp": true,
        "userLevel": 0
      },
      "tag": "skipi-socks"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "observatory": {
    "enableConcurrency": true,
    "probeInterval": "15s",
    "probeURL": "https://www.gstatic.com/generate_204",
    "subjectSelector": [
      "90-policy-"
    ]
  },
  "outbounds": [
    {
      "protocol": "loopback",
      "settings": {
        "inboundTag": "skipi-internal-default-route-loopback-in"
      },
      "tag": "skipi-internal-default-route-loopback"
    },
    {
      "protocol": "vless",
      "settings": {
        "address": "a.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "proxy"
    },
    {
      "protocol": "vless",
      "settings": {
        "address": "b.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "90-policy-2"
    },
    {
      "protocol": "vless",
      "settings": {
        "address": "c.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "90-policy-3"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "balancers": [
      {
        "fallbackTag": "90-policy-2",
        "selector": [
          "90-policy-"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "tag": "90"
      }
    ],
    "domainStrategy": "AsIs",
    "rules": [
      {
        "balancerTag": "90",
        "inboundTag": [
          "skipi-internal-default-route-loopback-in"
        ]
      },
      {
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "balancerTag": "90",
        "domain": [
          "geosite:google"
        ]
      },
      {
        "balancerTag": "90",
        "network": "tcp,udp"
      }
    ]
  }
