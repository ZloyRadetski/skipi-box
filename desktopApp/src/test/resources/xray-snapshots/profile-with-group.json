      "common.dot.dns.yandex.net": [
        "77.88.8.8",
        "77.88.8.1"
      ],
      "dns.adguard-dns.com": [
        "94.140.14.14",
        "94.140.15.15"
      ],
      "dns.alidns.com": [
        "223.5.5.5",
        "223.6.6.6"
      ],
      "dns.google": [
        "8.8.8.8",
        "8.8.4.4"
      ],
      "dns.quad9.net": [
        "9.9.9.9",
        "149.112.112.112"
      ],
      "doh.pub": [
        "1.12.12.12",
        "120.53.53.53"
      ],
      "one.one.one.one": [
        "1.1.1.1",
        "1.0.0.1"
      ]
    },
    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": [
          "domain:a.example",
          "domain:b.example"
        ],
        "skipFallback": true,
        "tag": "dns-direct"
      },
      {
        "address": "https://8.8.8.8/dns-query",
        "domains": [
          "domain:a.example",
          "domain:b.example"
        ],
        "skipFallback": true,
        "tag": "dns-direct"
      },
      "https://8.8.8.8/dns-query"
    ],
    "tag": "dns-proxy"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 20480,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "ip": "127.0.0.1",
        "udp": true,
        "userLevel": 0
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "tag": "skipi-socks"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "observatory": {
    "enableConcurrency": true,
    "probeInterval": "60s",
    "probeURL": "https://example.com/ping",
    "subjectSelector": [
      "shadowrocket-group:Fast-policy-"
    ]
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "address": "a.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "proxy"
    },
    {
      "protocol": "vless",
      "settings": {
        "address": "b.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "2"
    },
    {
      "protocol": "vless",
      "settings": {
        "address": "a.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "shadowrocket-group:Fast-policy-1"
    },
    {
      "protocol": "vless",
      "settings": {
        "address": "b.example",
        "encryption": "none",
        "id": "8b4a2b20-c533-4d13-a3e0-bb0a8d7eb9c6",
        "port": 443
      },
      "streamSettings": {
        "network": "raw"
      },
      "tag": "shadowrocket-group:Fast-policy-2"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "balancers": [
      {
        "fallbackTag": "shadowrocket-group:Fast-policy-1",
        "selector": [
          "shadowrocket-group:Fast-policy-"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "tag": "shadowrocket-group:Fast"
      }
    ],
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "dns-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "inboundTag": [
          "dns-proxy"
        ],
        "outboundTag": "proxy"
      },
      {
        "balancerTag": "shadowrocket-group:Fast",
        "domain": [
          "geosite:google"
        ],
        "ruleTag": "DOMAIN-SET,geosite:google"
      },
      {
        "domain": [
          "geosite:steam"
        ],
        "outboundTag": "2",
        "ruleTag": "DOMAIN-SET,geosite:steam"
      },
      {
        "domain": [
          "geosite:claude"
        ],
        "outboundTag": "proxy",
        "ruleTag": "DOMAIN-SET,geosite:claude"
      },
      {
        "domain": [
          "geosite:discord"
        ],
        "outboundTag": "direct",
        "ruleTag": "DOMAIN-SET,geosite:discord"
      },
      {
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block",
        "ruleTag": "DOMAIN-SET,geosite:category-ads-all"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}
